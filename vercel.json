{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/predict"
    }
  ],
  "functions": {
    "api/predict.py": {
      "maxDuration": 300,
      "includeFiles": "{model/best.tflite,model/tiles.json,public/demo-tiles/**}",
      "excludeFiles": "{model/*.pt,model/*.ipynb,model/tiles.example.json,ml/**,scripts/**,docs/**,output/**,.ml-data/**,.ml-runs/**,.venv/**}"
    }
  }
}
