%%{init: {"theme": "base", "themeVariables": {"fontSize": "26px", "fontFamily": "Arial", "primaryTextColor": "#111827"}, "themeCSS": ".nodeLabel, .edgeLabel, .labelBkg { font-size: 26px !important; }"}}%%
flowchart LR
  A[Reviewer selects<br/>district or upload] --> B[Dashboard sends<br/>prediction request]
  B --> C[API loads tile<br/>or uploaded crop]
  C --> D[LiteRT YOLO-OBB<br/>runs inference]
  D --> E[API thresholds,<br/>runs NMS, maps coordinates]
  E --> F[Dashboard renders<br/>markers, list, detail sheet]
  F --> G[Reviewer inspects<br/>tile evidence and OBB]

  classDef user fill:#f3f0ff,stroke:#7950f2,color:#1f1235;
  classDef ui fill:#edf2ff,stroke:#4c6ef5,color:#1c2d5a;
  classDef api fill:#fff3bf,stroke:#f08c00,color:#3b2500;
  classDef model fill:#e6fcf5,stroke:#099268,color:#073b2a;
  class A,G user;
  class B,F ui;
  class C,E api;
  class D model;
